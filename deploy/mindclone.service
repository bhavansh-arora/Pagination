# Non-Docker install: copy to /etc/systemd/system/mindclone.service, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now mindclone
[Unit]
Description=Mindclone
After=network.target

[Service]
Type=simple
User=mindclone
WorkingDirectory=/opt/mindclone
EnvironmentFile=/opt/mindclone/.env
Environment=NODE_ENV=production PORT=3000 HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
