# Reverse proxy template for serving the admin UI over HTTPS on a real
# domain. The app itself binds to 127.0.0.1 only (see src/config.ts's
# HOST) - nginx is what's actually reachable from the internet.
#
# setup.sh fills in __DOMAIN__ and __PORT__ and installs this at
# /etc/nginx/sites-available/<domain>. Certbot (run separately, see
# README) then rewrites this file in place to add the actual TLS
# certificate paths and an HTTP->HTTPS redirect.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;

        # Needed for the /dashboard WebSocket - plain proxy_pass alone
        # doesn't forward the Upgrade handshake.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The dashboard WebSocket is a long-lived connection (a whole
        # call), not a quick request/response - don't let nginx's default
        # read timeout hang up on it mid-conversation.
        proxy_read_timeout 3600s;
    }
}
