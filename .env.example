# Server
PORT=3000
# Public HTTPS/WSS host Twilio can reach (e.g. your ngrok domain or deployed domain),
# without protocol, e.g. "myagent.ngrok.app" or "voice.example.com"
PUBLIC_HOST=

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Deepgram speech-to-text (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ElevenLabs text-to-speech (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
