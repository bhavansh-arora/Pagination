# Server
PORT=3000
# Public HTTPS/WSS host Twilio can reach (e.g. your ngrok domain or deployed domain),
# without protocol, e.g. "myagent.ngrok.app" or "voice.example.com"
PUBLIC_HOST=

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Local, self-hosted speech microservice (tts-service/) - handles both
# speech-to-text (Whisper) and text-to-speech (Piper/MeloTTS). No cloud
# speech API of any kind. Run `uvicorn server:app` in tts-service/ and
# point this at it.
LOCAL_SPEECH_SERVICE_URL=http://127.0.0.1:8001

# Voice-activity detection tuning (src/utils/vad.ts) - telephone line/mic
# noise floors vary, so these will likely need adjusting for your setup.
# VAD_ENERGY_THRESHOLD=500
# VAD_SILENCE_HANGOVER_MS=700
