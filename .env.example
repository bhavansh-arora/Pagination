# Server
PORT=3000
# Public HTTPS/WSS host Twilio can reach (e.g. your ngrok domain or deployed domain),
# without protocol, e.g. "myagent.ngrok.app" or "voice.example.com"
PUBLIC_HOST=

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Deepgram speech-to-text (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Local, self-hosted TTS microservice (tts-service/) - no cloud TTS API.
# Run `uvicorn server:app` in tts-service/ and point this at it.
LOCAL_TTS_URL=http://127.0.0.1:8001
FFMPEG_PATH=ffmpeg
