PORT=3000

GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Push leads found here straight into the CRM with one click. Both must be
# set (and CRM_LEADS_SECRET must match the CRM's EXTERNAL_LEADS_SECRET) for
# the "Push to CRM" button to work. CRM_API_URL is the CRM's address on the
# shared Docker network (its compose service name), not the public domain.
CRM_API_URL=http://app:3000
CRM_LEADS_SECRET=
CRM_LEAD_SOURCE=US
