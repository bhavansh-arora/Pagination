# --- Required -------------------------------------------------------------

# Anthropic API key used by every mind (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# The first admin account. Created on startup if it doesn't exist (an existing
# account with this email is promoted to admin; its password is not changed).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long
ADMIN_NAME=Your Name

# Domain pointing at your VPS (Docker + Caddy setup uses it for automatic HTTPS)
DOMAIN=sagely.example.com

# --- Payments (Stripe Connect) — needed for coaches to charge clients ------

# Stripe secret key (sk_live_... or sk_test_... while testing)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<DOMAIN>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Email (password resets, invites, application & quota emails) ----------
# Any SMTP provider works: Resend, Postmark, Amazon SES, Mailgun, Gmail…
# e.g. smtps://resend:re_xxx@smtp.resend.com:465
SMTP_URL=
MAIL_FROM="Sagely <hello@yourdomain.com>"

# --- Optional -------------------------------------------------------------

# Public URL used in Stripe redirect links (defaults to the request's own host)
# APP_URL=https://sagely.example.com

# Where all data is stored. The Docker setup overrides this to a named volume.
# DATA_DIR=./data

# Session cookies are marked Secure automatically when served over HTTPS.
# Force it with true/false if your proxy doesn't send X-Forwarded-Proto.
# COOKIE_SECURE=
